(version 1)

# Mains side (230 V, floating pins on that side, and the radiator electronics at mains potential: Linap bus, Boost key)
# to low voltage: 3 mm through air, 6 mm along the board
(rule "mains_to_low_voltage"
  (constraint clearance (min 3mm))
  (constraint creepage (min 6mm))
  (condition "(A.hasNetclass('Mains') || A.hasNetclass('MainsNC') || A.hasNetclass('Linap')) && !B.hasNetclass('Mains') && !B.hasNetclass('MainsNC') && !B.hasNetclass('Linap') && B.Type != 'Hole'"))

# Between 230 V conductors, and between them and the Linap bus; the Linap wires are a few volts apart from each other.
# Terminal blocks keep their own rated 5.08 mm pitch
(rule "mains_between_conductors"
  (constraint clearance (min 2.5mm))
  (condition "A.hasNetclass('Mains') && (B.hasNetclass('Mains') || B.hasNetclass('Linap')) && A.NetName != B.NetName && !(A.memberOfFootprint('J1') && B.memberOfFootprint('J1'))"))
