# Copy to secrets.env (not versioned) and fill in: read by mitm/build.rs at compile time
WIFI_SSID="my-wifi"
WIFI_PASSWORD="my-wifi-password"
# Mosquitto of Home Assistant, by IP address
MQTT_HOST="192.168.1.10"
# Leave both empty for a broker that allows anonymous clients
MQTT_USER="sauter-marapi"
MQTT_PASSWORD="my-mqtt-password"
# Over-the-air updates (firmware/tools/ota.py): generate with openssl rand -hex 16
OTA_PASSWORD="my-ota-password"
# Optional fallback network, tried when the home one gives no address (phone hotspot next to the radiator),
# and the broker reachable through it (empty: no MQTT on that network, the board just shows on the phone)
WIFI_FALLBACK_SSID="my-phone-hotspot"
WIFI_FALLBACK_PASSWORD="my-phone-hotspot-password"
MQTT_FALLBACK_HOST=""
