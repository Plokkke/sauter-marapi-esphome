	(text "ON THE RADIATOR (STAGES 1 AND 3), EVERYTHING INSIDE THE RED FRAME IS AT MAINS POTENTIAL" (exclude_from_sim no) (at 58.42 52.07 0) (effects (font (size 1.8 1.8) (bold yes) (color 200 0 0 1)) (justify left bottom)) (uuid "7085c04d-4916-44f0-aa77-5feaae283719"))
	(text "Notes" (exclude_from_sim no) (at 58.42 137.16 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "d85aaccf-07cc-4479-8d73-01ada9d940d9"))
	(text "Stage 1, sniffer (radiator): J2 taps the ribbon between both boards. J1 powers, JP1 open. Q1 stays off." (exclude_from_sim no) (at 58.42 140.97 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "11831b49-fc56-40b5-8488-32b1be0834cc"))
	(text "Stage 2, power emulator (bench, NO MAINS): J2 to the command board alone. USB powers, J1 unplugged, JP1 closed." (exclude_from_sim no) (at 58.42 144.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "490173a8-7826-46dc-afd6-c76b60039944"))
	(text "Stage 3, controller emulator (radiator): J2 to the power board alone. J1 powers, JP1 open." (exclude_from_sim no) (at 58.42 148.59 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5cc55e54-7b0c-47c5-b62c-b51ef449018e"))
	(text "R7 (crossed: stage 3 only): the command board is the bus pull-up, so the power board alone needs R7." (exclude_from_sim no) (at 58.42 152.4 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5953b21f-1345-4f0d-bf39-96efa869fe8b"))
	(text "1. Flash over USB BEFORE wiring, then unplug it for good: never USB while J2 reaches the power board." (exclude_from_sim no) (at 58.42 156.21 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a282b0c3-dd37-4578-aa37-aef34d28498d"))
	(text "2. Lab supply output must float: no earth terminal, no link between - and earth. Set 5.0 V, limit 300 mA." (exclude_from_sim no) (at 58.42 160.02 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c45a6864-8b81-4085-b592-d49aa4ac7b11"))
	(text "3. Wire with the breaker OFF. Once powered, touch nothing: read and drive over Wi-Fi only." (exclude_from_sim no) (at 58.42 163.82999999999998 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "258f7bce-1472-4d48-b838-474339e1ed7e"))
	(text "Revision 1 (2026-11-07): listen only. Revision 2 (2026-11-08): Q1 + R6 transmit from D8, R7 optional pull-up." (exclude_from_sim no) (at 58.42 167.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "61bea02b-f6c2-4dc0-ba9a-a6f5efd8284b"))
